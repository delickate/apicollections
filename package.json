{
  "name": "api-collections",
  "productName": "API Collections",
  "version": "1.0.0",
  "description": "Desktop API client: nested folders, collections, requests, import/export and Postman import.",
  "main": "src/main/main.js",
  "author": "Delickate",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "make-icon": "node scripts/start.js --run=scripts/make-icon.js",
    "make-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-cert.ps1",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.delickate.api-collections",
    "productName": "API Collections",
    "copyright": "Copyright © 2026 Delickate",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/logo.svg",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": ["en-US"],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Delickate",
        "signingHashAlgorithms": ["sha256"],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "API Collections",
      "uninstallDisplayName": "API Collections ${version}",
      "artifactName": "API-Collections-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "API-Collections-Portable-${version}.${ext}"
    }
  }
}
